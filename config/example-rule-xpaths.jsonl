{"ruleKey": 1, "catalogId": "AvoidCatchingThrowable", "xpath": "//CatchParameter[ClassType[pmd-java:typeIsExactly('java.lang.Throwable')]]/VariableId"}
{"ruleKey": 2, "catalogId": "AvoidPrintStackTrace", "xpath": "//MethodCall[ pmd-java:matchesSig(\"java.lang.Throwable#printStackTrace()\") ]"}
{"ruleKey": 3, "catalogId": "AvoidStringBufferField", "xpath": "//FieldDeclaration/ClassType[pmd-java:typeIs('java.lang.StringBuffer') or pmd-java:typeIs('java.lang.StringBuilder')]"}
{"ruleKey": 4, "catalogId": "AvoidThrowingRawExceptionTypes", "xpath": "//ThrowStatement//ConstructorCall\n /ClassType[\n pmd-java:typeIsExactly('java.lang.Throwable')\nor\n pmd-java:typeIsExactly('java.lang.Exception')\nor\n pmd-java:typeIsExactly('java.lang.Error')\nor\n pmd-java:typeIsExactly('java.lang.RuntimeException')\n]"}
{"ruleKey": 5, "catalogId": "CollapsibleIfStatements", "xpath": "//IfStatement[@Else = false()]/IfStatement[@Else = false()]\n|\n//IfStatement[@Else = false()]/Block[count(*) = 1]/IfStatement[@Else = false()]"}
{"ruleKey": 6, "catalogId": "SystemPrintln", "xpath": "//MethodCall[ starts-with(@MethodName, 'print') ]\n  /FieldAccess[ @Name = ('err', 'out') ]\n  /TypeExpression[ pmd-java:typeIsExactly('java.lang.System') ]"}
{"ruleKey": 7, "catalogId": "UnusedLabel", "xpath": "//LabeledStatement[let $label := @Label return\n      not( (.//BreakStatement | .//ContinueStatement)[@Label = $label] )\n]"}
{"ruleKey": 8, "catalogId": "UseVarargs", "xpath": "//FormalParameters[not(parent::MethodDeclaration[@Overridden=true() or @MainMethod=true()])]\n  /FormalParameter[position()=last()]\n   [@Varargs=false()]\n   [ArrayType[not(PrimitiveType[@Kind = \"byte\"] or ClassType[pmd-java:typeIs('java.lang.Byte')])]\n    or VariableId[ArrayDimensions] and (PrimitiveType[not(@Kind=\"byte\")] or ClassType[not(pmd-java:typeIs('java.lang.Byte'))])]"}
